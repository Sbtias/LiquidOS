[Unit]
Description=LiquidOS — preparación del primer arranque (Flathub y catálogo)
Documentation=https://github.com/liquidos/liquidos
After=network-online.target flatpak-system-helper.service
Wants=network-online.target
ConditionPathExists=!/var/lib/liquidos/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/liquidos-firstboot
RemainAfterExit=yes
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
