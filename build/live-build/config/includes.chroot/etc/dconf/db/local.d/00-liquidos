# ============================================================
# LiquidOS 1.0 — valores por defecto del escritorio
# Se aplican a todos los usuarios (perfil «user» de dconf).
# ============================================================

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='WhiteSur-Dark'
icon-theme='WhiteSur-dark'
cursor-theme='WhiteSur-cursors'
cursor-size=24
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'
clock-format='24h'
clock-show-weekday=true
clock-show-seconds=false
show-battery-percentage=true
enable-animations=true
enable-hot-corners=false

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/liquidos/liquidos-dark.svg'
picture-uri-dark='file:///usr/share/backgrounds/liquidos/liquidos-dark.svg'
picture-options='zoom'
primary-color='#05070c'
color-shading-type='solid'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/liquidos/liquidos-dark.svg'
primary-color='#05070c'
lock-delay=uint32 300
idle-activation-enabled=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
theme='WhiteSur-Dark'
titlebar-font='Inter Bold 11'
action-double-click-titlebar='toggle-maximize'
action-middle-click-titlebar='lower'
resize-with-right-button=true

[org/gnome/desktop/wm/keybindings]
close=['<Super>q']
minimize=['<Super>m']
toggle-maximized=['<Super>Up']

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true

[org/gnome/desktop/search-providers]
disabled=['org.gnome.Characters.desktop','org.gnome.font-viewer.desktop']

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'appindicatorsupport@rgcjonas.gmail.com']
disable-user-extensions=false
welcome-dialog-last-shown-version='99.0'

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
transparency-mode='DYNAMIC'
custom-background-color=true
background-color='rgb(18,20,28)'
background-opacity=0.55
custom-theme-shrink=true
running-indicator-style='DOTS'
click-action='minimize-or-previews'
scroll-action='switch-workspace'
show-trash=true
show-mounts=false
show-apps-at-top=true
dash-max-icon-size=48
icon-size-fixed=false
hot-keys=false
preferred-monitor=-2
animate-show-apps=true
animate-app-switch=true
animate-app-close=true
autohide-in-fullscreen=true

[org/gnome/mutter]
experimental-features=['scale-monitor-framebuffer']
center-new-windows=true
edge-tiling=true
dynamic-workspaces=true

[org/gnome/settings-daemon/plugins/color]
night-light-enabled=false

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='suspend'
sleep-inactive-battery-timeout=1800

[org/gnome/software]
download-updates=false
allow-updates=true

[org/gtk/settings/file-chooser]
clock-format='24h'
