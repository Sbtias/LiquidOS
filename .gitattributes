# Los scripts se ejecutan dentro de Linux (chroot, Docker, CI): siempre LF.
*.sh            text eol=lf
*.hook.chroot   text eol=lf
*.desktop       text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf

# Todo el árbol de live-build y los scripts se ejecutan dentro de Linux:
# sin CRLF, aunque el repositorio se clone en Windows.
build/live-build/config/**      text eol=lf
scripts/**                      text eol=lf
.gitattributes                  text eol=lf

# Textos y código de la vista previa
*.md            text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.yml           text eol=lf
.dockerignore   text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.svg           text eol=lf
